<main class="auth-page">
  <section class="auth-card">
    <div class="logo">
      <ruby>ヨリミチ<rt>サインイン</rt></ruby><span class="ya">入店</span>
    </div>
    <p class="auth-lead">そこのハイカラさ～ん、ちょいと寄っていきなんし♪</p>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "hagoromo@example.com" %>
      </div>
      <div class="field">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>
      <% if devise_mapping.rememberable? %>
        <div class="remember-field">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "しばらく居座る" %>
        </div>
      <% end %>
      <div class="actions">
        <%= f.submit "ログイン" %>
      </div>
    <% end %>
    <div class="auth-links">
      <%= link_to "シンガオ来店（サインアップ）", new_registration_path(resource_name) %>
      <%= link_to "パスワードを忘れたのかい？", new_password_path(resource_name) %>
    </div>
  </section>
</main>