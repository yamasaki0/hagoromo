<main class="auth-page">
  <section class="auth-card">
    <div class="logo">
      <ruby>シンガオ<rt>サインアップ</rt></ruby><span class="ya">来店</span>
    </div>
    <p class="auth-lead">あら、見ない顔だね。ハイカラなハゴロモ着てるじゃない。</p>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "hagoromo@example.com" %>
      </div>
      <div class="field">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>
      <div class="field">
        <%= f.label :password_confirmation, "パスワード確認" %>
        <%= f.password_field :password_confirmation, autocomplete: "current-password" %>
      </div>
      <div class="actions">
        <%= f.submit "サインアップ" %>
      </div>
    <% end %>
    <div class="auth-links">
      <%= link_to "サインイン", new_session_path(resource_name) %>
    </div>
  </section>
</main>