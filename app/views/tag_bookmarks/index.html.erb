<p style="color: green"><%= notice %></p>

<% content_for :title, "Tag bookmarks" %>

<h1>Tag bookmarks</h1>

<div id="tag_bookmarks">
  <% @tag_bookmarks.each do |tag_bookmark| %>
    <%= render tag_bookmark %>
    <p>
      <%= link_to "Show this tag bookmark", tag_bookmark %>
    </p>
  <% end %>
</div>

<%= link_to "New tag bookmark", new_tag_bookmark_path %>
